
@page "/registro"
@using System.Net.Http.Json
@using System.Net.Http
@using System.Text.Json
@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>Crear cuenta | ¿Qué Queda?</PageTitle>

<main class="form-page">
    <section class="form-card">

        <div class="form-brand">
            <div class="form-logo">
                <img src="/icon-192.png"
                    alt="¿Qué Queda?"
                    style="width:100%; height:100%; object-fit:contain;" />
            </div>
            <h1>¿Qué Queda?</h1>
            <p>Tu hogar, al día.</p>
        </div>

        <div class="form-heading">
            <h2>Crear cuenta</h2>
            <p>Organiza tu hogar con ayuda de la inteligencia artificial.</p>
        </div>

        @if (registroExitoso)
        {
            <div class="alert alert-success" role="status">
                ¡Cuenta creada correctamente! Ya puedes iniciar sesión.
            </div>

            <button class="form-submit"
                    type="button"
                    @onclick="IrALogin">
                Ir a iniciar sesión
            </button>
        }
        else
        {
            <form @onsubmit="RegistrarUsuarioAsync"
                  @onsubmit:preventDefault="true">

                <div class="form-field">
                    <label for="nombre">Nombre</label>
                    <input id="nombre"
                           type="text"
                           @bind="nombre"
                           autocomplete="given-name"
                           placeholder="Tu nombre"
                           maxlength="100"
                           required />
                </div>

                <div class="form-field">
                    <label for="correo">Correo electrónico</label>
                    <input id="correo"
                           type="email"
                           @bind="correo"
                           autocomplete="email"
                           placeholder="nombre@correo.cl"
                           maxlength="150"
                           required />
                </div>

                <div class="form-field">
                    <label for="contrasena">Contraseña</label>
                    <input id="contrasena"
                           type="password"
                           @bind="contrasena"
                           autocomplete="new-password"
                           placeholder="Mínimo 12 caracteres"
                           minlength="12"
                           required />
                    <small>Utiliza al menos 12 caracteres.</small>
                </div>

                <div class="form-field">
                    <label for="confirmarContrasena">
                        Confirmar contraseña
                    </label>
                    <input id="confirmarContrasena"
                           type="password"
                           @bind="confirmarContrasena"
                           autocomplete="new-password"
                           placeholder="Repite tu contraseña"
                           minlength="12"
                           required />
                </div>

                @if (!string.IsNullOrWhiteSpace(mensaje))
                {
                    <div class="alert alert-error" role="alert">
                        @mensaje
                    </div>
                }

                <button class="form-submit"
                        type="submit"
                        disabled="@procesando">
                    @(procesando ? "Creando cuenta..." : "Crear cuenta")
                </button>
            </form>

            <p class="form-footer">
                ¿Ya tienes una cuenta?
                <a href="@LoginUrl">Iniciar sesión</a>
            </p>
        }

    </section>
</main>

@code {
    private string nombre = "";
    private string correo = "";
    private string contrasena = "";
    private string confirmarContrasena = "";
    private string mensaje = "";
    private string? returnUrl;

    private bool procesando = false;
    private bool registroExitoso = false;

    private async Task RegistrarUsuarioAsync()
    {
        mensaje = "";

        if (contrasena.Length < 12)
        {
            mensaje = "La contraseña debe tener al menos 12 caracteres.";
            return;
        }

        if (contrasena != confirmarContrasena)
        {
            mensaje = "Las contraseñas no coinciden.";
            return;
        }

        procesando = true;

        try
        {
            var datos = new
            {
                nombre = nombre.Trim(),
                correo = correo.Trim(),
                contrasena
            };

            var respuesta = await Http.PostAsJsonAsync(
                "api/usuarios/registro",
                datos
            );

            if (respuesta.IsSuccessStatusCode)
            {
                registroExitoso = true;
            }
            else
            {
                var contenido = await respuesta.Content.ReadAsStringAsync();

                try
                {
                    using var documento = JsonDocument.Parse(contenido);

                    if (documento.RootElement.TryGetProperty(
                        "mensaje", out var mensajeApi))
                    {
                        mensaje = mensajeApi.GetString()
                            ?? "No fue posible crear la cuenta.";
                    }
                    else
                    {
                        mensaje = "No fue posible crear la cuenta.";
                    }
                }
                catch
                {
                    mensaje = "No fue posible crear la cuenta. Verifica los datos e inténtalo nuevamente.";
                }
            }
        }
        catch (HttpRequestException)
        {
            mensaje = "No se pudo conectar con el servidor. Inténtalo nuevamente.";
        }
        catch (Exception)
        {
            mensaje = "Ocurrió un error inesperado al crear la cuenta.";
        }
        finally
        {
            procesando = false;
        }
    }

    private string LoginUrl =>
    string.IsNullOrWhiteSpace(returnUrl)
        ? "/login"
        : $"/login?returnUrl={Uri.EscapeDataString(returnUrl)}";

    private void IrALogin()
    {
        Navigation.NavigateTo(LoginUrl);
    }

    protected override void OnInitialized()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);

        foreach (var parametro in uri.Query.TrimStart('?').Split('&'))
        {
            var partes = parametro.Split('=', 2);

            if (partes.Length != 2 ||
                Uri.UnescapeDataString(partes[0]) != "returnUrl")
            {
                continue;
            }

            var candidato = Uri.UnescapeDataString(
                partes[1].Replace("+", " ")
            );

            if (candidato.StartsWith("/") &&
                !candidato.StartsWith("//") &&
                !candidato.Contains('\\'))
            {
                returnUrl = candidato;
            }

            break;
        }
    }
}
