
@page "/asistente"
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.Components
@using System.Globalization;
@using System.Text;
@using Microsoft.JSInterop
@using System.Net.Http.Json
@using System.Text.Json
@using QueQueda.Client.Services
@using QueQueda.Client.Models
@using QueQueda.Client.Components
@inject IJSRuntime JS
@inject AuthService Auth
@inject ProductoService ProductoService
@inject HogarService Hogares
@inject InventarioService InventarioSvc
@inject ResolverProductoService ResolverProductoSvc
@inject IConfiguration Configuration
@implements IAsyncDisposable
@using System.Text.RegularExpressions

<PageTitle>Asistente IA | ¿Qué Queda?</PageTitle>

<div class="card qq-assistant-card">

    <div class="qq-assistant-heading">
        <div class="qq-assistant-icon">✳</div>
        <div>
            <h2>Asistente IA</h2>
            <p>Tu hogar, en una conversación.</p>
        </div>
    </div>

    <div class="qq-chat">

        @TarjetaBienvenida

        @foreach (var mensaje in mensajes)
        {
            @if (!mensaje.EsUsuario &&
                mensaje.Texto.StartsWith("¡Ups!", StringComparison.OrdinalIgnoreCase))
            {
                <MensajeAsistente
                    Mensaje="mensaje"
                    OnConfirmarAgregar="ConfirmarAgregarProducto"
                    OnCancelarAgregar="CancelarAgregarProducto" />
                @TarjetaBienvenida
            }
            else
            {
                <MensajeAsistente
                    Mensaje="mensaje"
                    OnConfirmarAgregar="ConfirmarAgregarProducto"
                    OnCancelarAgregar="CancelarAgregarProducto" />            }
        }

        @if (enviando)
        {
            <div class="qq-chat-message qq-chat-message-assistant">
                <span class="qq-chat-message-label">ASISTENTE IA</span>
                <div class="qq-typing">
                    <span></span>
                    <span></span>
                    <span></span>
                </div>
            </div>
        }

        <div @ref="chatEnd"></div>

    </div>

    <div class="qq-chat-suggestions">
        <span class="qq-chat-suggestions-label">PRUEBA CON:</span>

        <button class="qq-chat-suggestion"
                @onclick='() => Enviar("¿Qué queda en el inventario?")'
                disabled="@enviando">
            ¿Qué queda en el inventario?
        </button>

        <button class="qq-chat-suggestion"
                @onclick='() => Enviar("¿Hay huevos?")'
                disabled="@enviando">
            ¿Hay huevos?
        </button>
    </div>

    <div class="qq-chat-schedule">
        <span class="qq-chat-schedule-icon">🕘</span>
        <div>
            <strong>Horario del servicio IA</strong>
            <span>Lunes a viernes · 09:00 a 17:00 hrs.</span>
        </div>
    </div>

    <div class="qq-chat-composer">

        <textarea @bind="texto"
                @bind:event="oninput"
                @onkeydown="ManejarTecla"
                placeholder="Escribe o dicta un mensaje..."
                rows="2"
                disabled="@enviando"></textarea>

        @if (escuchando)
        {
            <div class="qq-audio-monitor">
                <div class="qq-audio-bars">
                    @for (int i = 0; i < 9; i++)
                    {
                        int altura = Math.Max(3, nivelAudio * (i % 3 + 1) / 3);
                        <span style="height: @(altura)px"></span>
                    }
                </div>
                <span>
                    @(nivelAudio > 5 ? "Recibiendo audio..." : "No se está recibiendo audio")
                </span>
            </div>
        }

        <button class="qq-chat-mic @(escuchando ? "qq-chat-mic-active" : "")"
                @onclick="AlternarMicrofono"
                disabled="@enviando"
                title="Dictar mensaje">
            @(escuchando ? "■" : "🎙")
        </button>

        <button class="qq-chat-send"
                @onclick="EnviarMensaje"
                disabled="@(enviando || string.IsNullOrWhiteSpace(texto))">
            @(enviando ? "…" : "↑")
        </button>

    </div>



    <div class="qq-chat-status">
        <span class="qq-chat-status-dot"></span>
        @estado
    </div>

</div>

@code {
private string WebhookUrl =>
    Configuration["N8N:WebhookUrl"] ?? "";

    private readonly HttpClient HttpN8n = new HttpClient();
    private string texto = "";
    private string estado = "Conexión con el asistente disponible para pruebas.";
    private bool enviando = false;

    private bool escuchando = false;
    private DotNetObjectReference<Asistente>? referenciaJS;
    private int nivelAudio = 0;

    private ElementReference chatEnd;
    private bool desplazarPendiente = false;

    private List<ProductoDto> productosCatalogo = new();

    private string sessionId = "";
    private List<MensajeChat> mensajes = new();

    private string nombreUsuario = "";
    private string nombreHogar = "";

    private string ultimaIntencion = "";
    

    private EstadoConversacion estadoConversacion = EstadoConversacion.Normal;

    private string nombreProductoPendiente = "";

    private ProductoDto? productoPendiente;


    private enum EstadoConversacion
    {
        Normal,
        EsperandoConfirmacionProducto,
        EsperandoDatosProducto,
        EsperandoCantidad
    }


    private async Task EnviarMensaje()
    {
        await Enviar(texto);
    }

    private async Task Enviar(string contenido)
    {
        if (string.IsNullOrWhiteSpace(contenido) || enviando)
            return;

       contenido = contenido.Trim();

        string mensajeOriginal = contenido;

        // Detectar y retirar saludos iniciales
        string contenidoNormalizado = NormalizarTexto(contenido);

        contenido = SaludoInicial
            .Replace(contenidoNormalizado, "")
            .Trim();

        // Mostrar el mensaje original del usuario
        mensajes.Add(new MensajeChat
        {
            Texto = mensajeOriginal,
            EsUsuario = true
        });

        // Si estamos esperando una cantidad, procesarla directamente en Blazor.
        if (estadoConversacion == EstadoConversacion.EsperandoCantidad)
        {
            texto = "";
            await RegistrarCantidadProductoAsync(contenido);
            return;
        }

        // Si era solamente un saludo, responder desde Blazor
        if (string.IsNullOrWhiteSpace(contenido))
        {
            mensajes.Add(new MensajeChat
            {
                Texto = CrearSaludoLocal(),
                EsUsuario = false
            });

            estado = "Asistente disponible.";
            texto = "";

            SolicitarDesplazamiento();
            await InvokeAsync(StateHasChanged);
            return;
        }

        texto = "";

        enviando = true;
        estado = "El asistente está pensando...";

        SolicitarDesplazamiento();
        await InvokeAsync(StateHasChanged);
        try
        {


           var datos = new
            {
                chatInput = contenido,
                sessionId = sessionId,
                usuario = nombreUsuario,
                hogar = nombreHogar,
                contexto_anterior = new
                {
                    ultima_intencion = ultimaIntencion,
                },
                productos = productosCatalogo.Select(p => new
                {
                    id_producto = p.IdProducto,
                    nombre = p.Nombre,
                    categoria = p.Categoria,
                    unidad_medida = p.UnidadMedida
                }).ToList()
            };

            using var respuesta = await HttpN8n.PostAsJsonAsync(
                WebhookUrl,
                datos
            );

            respuesta.EnsureSuccessStatusCode();

            using var documento = await JsonDocument.ParseAsync(
                await respuesta.Content.ReadAsStreamAsync()
            );

            string respuestaIA = BuscarRespuesta(documento.RootElement);

            if (respuestaIA.StartsWith("No te entendí", StringComparison.OrdinalIgnoreCase))
            {
                respuestaIA = "¡Ups! 😅 No te entendí muy bien. ¿Puedes explicármelo de otra forma?";
            }

            if (string.IsNullOrWhiteSpace(respuestaIA))
            {
                throw new Exception("N8N no devolvió un texto de respuesta.");
            }
            var mensajeRespuesta = new MensajeChat
            {
                Texto = respuestaIA,
                EsUsuario = false,
                Tipo = "texto"
            };

            try
            {
                using var clasificacion = JsonDocument.Parse(respuestaIA);
                var raiz = clasificacion.RootElement;
                if (raiz.TryGetProperty("tipo_consulta", out var tipo))
                {
                    string tipoConsulta = tipo.GetString() ?? "";

                    if (tipoConsulta == "GENERAL" || tipoConsulta == "ESPECIFICA")
                    {
                        ultimaIntencion = "CONSULTAR_INVENTARIO";
                    }

                    if (tipoConsulta == "GENERAL")
                    {
                        mensajeRespuesta = await ProcesarConsultaInventarioGeneralAsync();
                    }
                    else if (tipoConsulta == "ESPECIFICA")
                    {
                        string nombreProducto = "";

                        if (raiz.TryGetProperty("producto", out var producto))
                        {
                            nombreProducto = producto.GetString() ?? "";
                        }

                        mensajeRespuesta = await ProcesarConsultaInventarioEspecificaAsync(
                            nombreProducto
                        );
                    }
                }

            }
            catch (JsonException)
            {
                // Si N8N devuelve texto normal, se conserva la respuesta original.
            }

            mensajes.Add(mensajeRespuesta);


            estado = "Asistente conectado.";
        }
        catch (Exception ex)
        {
            mensajes.Add(new MensajeChat
            {
                Texto = "No pude comunicarme con el asistente. Detalle: "
                        + ex.Message,
                EsUsuario = false
            });

            estado = "Error de conexión con N8N.";
        }
        finally
        {
            enviando = false;
            SolicitarDesplazamiento();
        }
    }

    private async Task<MensajeChat> ProcesarConsultaInventarioGeneralAsync()
    {
        if (!Auth.IdHogarActivo.HasValue)
        {
            return new MensajeChat
            {
                EsUsuario = false,
                Tipo = "aviso",
                Titulo = "Hogar no seleccionado",
                Texto = "No tienes un hogar activo seleccionado."
            };
        }

        var inventario = await InventarioSvc.ObtenerInventarioAsync(
            Auth.IdHogarActivo.Value
        );

        if (inventario.Count == 0)
        {
            return new MensajeChat
            {
                EsUsuario = false,
                Tipo = "texto",
                Titulo = "Inventario",
                Texto = "Tu hogar todavía no tiene productos registrados en el inventario."
            };
        }

        return new MensajeChat
        {
            EsUsuario = false,
            Tipo = "inventario",
            Titulo = "Esto es lo que tenemos en casa 🏠",
            Pie = $"{inventario.Count} productos disponibles",
            Elementos = inventario.Select(p => new DetalleMensaje
            {
                Nombre = p.Nombre,
                Cantidad = p.CantidadActual,
                Unidad = p.UnidadMedida ?? "",
                Icono = "📦"
            }).ToList()
        };
    }

    private async Task<MensajeChat> ProcesarConsultaInventarioEspecificaAsync(
        string nombreProducto)
    {
        if (!Auth.IdHogarActivo.HasValue)
        {
            return new MensajeChat
            {
                EsUsuario = false,
                Tipo = "aviso",
                Titulo = "Hogar no seleccionado",
                Texto = "No tienes un hogar activo seleccionado."
            };
        }

        if (string.IsNullOrWhiteSpace(nombreProducto))
        {
            return new MensajeChat
            {
                EsUsuario = false,
                Tipo = "aviso",
                Titulo = "Producto no identificado",
                Texto = "No pude identificar qué producto estás consultando."
            };
        }

        var inventario = await InventarioSvc.ObtenerInventarioAsync(
            Auth.IdHogarActivo.Value
        );

        var coincidencias = inventario
            .Where(p => string.Equals(
                p.Nombre.Trim(),
                nombreProducto.Trim(),
                StringComparison.OrdinalIgnoreCase
            ))
            .ToList();

        if (coincidencias.Count == 0)
        {
            coincidencias = inventario
                .Where(p => p.Nombre.Contains(
                    nombreProducto.Trim(),
                    StringComparison.OrdinalIgnoreCase
                ))
                .ToList();
        }

        if (coincidencias.Count == 0)
        {
            nombreProductoPendiente = nombreProducto.Trim();
            estadoConversacion = EstadoConversacion.EsperandoConfirmacionProducto;

            return new MensajeChat
            {
                EsUsuario = false,
                Tipo = "confirmar_agregar",
                Titulo = "Producto no encontrado",
                Texto = $"No tenemos {nombreProducto} registrado en el inventario de esta casa. ¿Quieres agregarlo?",
                ProductoPendiente = nombreProductoPendiente
            };
        }

        if (coincidencias.Count > 1)
        {
            return new MensajeChat
            {
                EsUsuario = false,
                Tipo = "aviso",
                Titulo = "Necesito precisar el producto",
                Texto = "Encontré varios productos similares: "
                    + string.Join(", ", coincidencias.Select(p => p.Nombre))
                    + ". ¿Cuál quieres consultar?"
            };
        }

        var encontrado = coincidencias[0];

        return new MensajeChat
        {
            EsUsuario = false,
            Tipo = "inventario",
            Titulo = $"Esto queda de {encontrado.Nombre} 🏠",
            Pie = "Cantidad disponible en el hogar",
            Elementos = new List<DetalleMensaje>
            {
                new DetalleMensaje
                {
                    Nombre = encontrado.Nombre,
                    Cantidad = encontrado.CantidadActual,
                    Unidad = encontrado.UnidadMedida ?? ""
                }
            }
        };
    }


    private void SolicitarDesplazamiento()
    {
        desplazarPendiente = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (desplazarPendiente)
        {
            desplazarPendiente = false;

            await JS.InvokeVoidAsync(
                "qqChat.scrollToBottom",
                chatEnd
            );
        }
    }

    private static string BuscarRespuesta(JsonElement elemento)
    {
        if (elemento.ValueKind == JsonValueKind.String)
            return elemento.GetString() ?? "";

        if (elemento.ValueKind == JsonValueKind.Array)
        {
            foreach (var item in elemento.EnumerateArray())
            {
                string resultado = BuscarRespuesta(item);

                if (!string.IsNullOrWhiteSpace(resultado))
                    return resultado;
            }
        }

        if (elemento.ValueKind == JsonValueKind.Object)
        {
            string[] propiedades =
            {
                "output",
                "text",
                "response",
                "message"
            };

            foreach (string propiedad in propiedades)
            {
                if (elemento.TryGetProperty(propiedad, out var valor))
                {
                    string resultado = BuscarRespuesta(valor);

                    if (!string.IsNullOrWhiteSpace(resultado))
                        return resultado;
                }
            }
        }

        return "";
    }

    
    private async Task ManejarTecla(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
            await EnviarMensaje();
    }

    protected override async Task OnInitializedAsync()
    {
        sessionId = await JS.InvokeAsync<string>(
            "qqChat.getOrCreateSessionId"
        );

        try
        {
            await Auth.InicializarAsync();

            nombreUsuario = Auth.Nombre ?? "";
            nombreHogar = "";

            if (Auth.IdHogarActivo.HasValue)
            {
                var hogares = await Hogares.ObtenerHogaresAsync();

                var hogarActivo = hogares.FirstOrDefault(
                    h => h.IdHogar == Auth.IdHogarActivo.Value
                );

                nombreHogar = hogarActivo?.Nombre ?? "";
            }

            productosCatalogo = await ProductoService.ObtenerProductosAsync();

            estado = $"Asistente disponible. {productosCatalogo.Count} productos cargados.";

        }
        catch (Exception ex)
        {
            estado = "No fue posible inicializar el asistente: " + ex.Message;
        }
    }

    private async Task AlternarMicrofono()
    {
        try
        {
            if (escuchando)
            {
                await JS.InvokeVoidAsync("qqChat.stopVoiceRecognition");
                escuchando = false;
                estado = "Dictado detenido.";
            }
            else
            {
                referenciaJS ??= DotNetObjectReference.Create(this);

                bool iniciado = await JS.InvokeAsync<bool>(
                    "qqChat.startVoiceRecognition",
                    referenciaJS
                );

                if (iniciado)
                {
                    escuchando = true;
                    estado = "Escuchando... habla ahora.";
                }
                else
                {
                    estado = "El reconocimiento de voz no está disponible.";
                }
            }
        }
        catch (Exception ex)
        {
            escuchando = false;
            estado = "Error al activar el micrófono: " + ex.Message;
        }
    }

    [JSInvokable]
    public async Task RecibirTextoVoz(string transcripcion)
    {
        if (!string.IsNullOrWhiteSpace(transcripcion))
        {
            texto = string.IsNullOrWhiteSpace(texto)
                ? transcripcion
                : texto.Trim() + " " + transcripcion;

            estado = "Voz reconocida. Revisa el texto antes de enviarlo.";
        }

        escuchando = false;
        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task ErrorReconocimientoVoz(string error)
    {
        escuchando = false;
        estado = "Error de reconocimiento de voz: " + error;

        await InvokeAsync(StateHasChanged);
    }


    public async ValueTask DisposeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("qqChat.stopVoiceRecognition");
        }
        catch
        {
        }

        referenciaJS?.Dispose();
    }

    private static readonly Regex SaludoInicial = new(
        @"^\s*[¡¿]?\s*(?:(?:hola+|holi+|hey+|buenos\s+dias|buenas\s+tardes|buenas\s+noches|buen\s+dia|buenas|como\s+estas|que\s+tal)\b[\s,!.¿?¡]*)+",
        RegexOptions.IgnoreCase | RegexOptions.CultureInvariant
    );

    private static string NormalizarTexto(string texto)
    {
        return string.Concat(
            texto.Normalize(NormalizationForm.FormD)
                .Where(c => CharUnicodeInfo.GetUnicodeCategory(c)
                    != UnicodeCategory.NonSpacingMark)
        ).Normalize(NormalizationForm.FormC);
    }


    private string CrearSaludoLocal()
    {
        string saludo = string.IsNullOrWhiteSpace(nombreUsuario)
            ? "¡Hola!"
            : $"¡Hola, {nombreUsuario}!";

        if (!string.IsNullOrWhiteSpace(nombreHogar))
            saludo += $" Bienvenido al hogar {nombreHogar}.";

        return saludo + " ¿En qué puedo ayudarte hoy?";
    }

    [JSInvokable]
    public async Task ActualizarNivelAudio(int nivel)
    {
        nivelAudio = Math.Clamp(nivel, 0, 100);
        await InvokeAsync(StateHasChanged);
    }



    private RenderFragment TarjetaBienvenida => @<div class="qq-chat-message qq-chat-message-assistant">
        <span class="qq-chat-message-label">ASISTENTE IA</span>
       <p> 
            ¡Hola! Soy el asistente del hogar
            <span class="qq-hogar-destacado">@nombreHogar</span>.
            Puedo ayudarte con estas tareas:
        </p>

        <p>
            🛒 <strong>1. Listas de compras</strong><br>
            Crear y gestionar listas de compras.
        </p>

        <p>
            📦 <strong>2. Registrar compras</strong><br>
            Agregar productos comprados y actualizar el inventario.
        </p>

        <p>
            🍽️ <strong>3. Registrar consumos</strong><br>
            Descontar los productos utilizados en el hogar.
        </p>

        <p>
            🔎 <strong>4. Consultar inventario</strong><br>
            Revisar productos disponibles y sus cantidades.
        </p>

        <p>¿Qué necesitas hacer hoy?</p>
    </div>;

    private async Task ConfirmarAgregarProducto(string nombreProducto)
    {
        try
        {
            var coincidencias = await ResolverProductoSvc.BuscarAsync(nombreProducto);

            if (coincidencias.Count == 0)
            {
                estadoConversacion = EstadoConversacion.EsperandoDatosProducto;

                mensajes.Add(new MensajeChat
                {
                    EsUsuario = false,
                    Tipo = "aviso",
                    Texto = $"No tengo {nombreProducto} en el catálogo. Próximamente podremos crearlo desde aquí."
                });
            }
            else if (coincidencias.Count > 1)
            {
                mensajes.Add(new MensajeChat
                {
                    EsUsuario = false,
                    Tipo = "aviso",
                    Texto = "Encontré varios productos similares: " +
                            string.Join(", ", coincidencias.Select(p => p.Nombre)) +
                            ". Necesitamos precisar cuál quieres agregar."
                });
            }
            else
            {
                productoPendiente = coincidencias[0];
                estadoConversacion = EstadoConversacion.EsperandoCantidad;

                mensajes.Add(new MensajeChat
                {
                    EsUsuario = false,
                    Texto = $"Encontré {productoPendiente.Nombre} en el catálogo. ¿Qué cantidad quieres registrar en el inventario de tu hogar?"
                });
            }
        }
        catch (Exception ex)
        {
            mensajes.Add(new MensajeChat
            {
                EsUsuario = false,
                Tipo = "aviso",
                Texto = "No pude buscar el producto: " + ex.Message
            });
        }

        SolicitarDesplazamiento();
        await InvokeAsync(StateHasChanged);
    }

    private async Task CancelarAgregarProducto()
    {
        estadoConversacion = EstadoConversacion.Normal;
        nombreProductoPendiente = "";
        productoPendiente = null;

        mensajes.Add(new MensajeChat
        {
            EsUsuario = false,
            Texto = "¡De acuerdo! No realizaremos ningún cambio."
        });

        SolicitarDesplazamiento();
        await InvokeAsync(StateHasChanged);
    }

    private async Task RegistrarCantidadProductoAsync(string contenido)
    {
        if (!decimal.TryParse(
            contenido.Trim(),
            NumberStyles.Number,
            CultureInfo.CurrentCulture,
            out decimal cantidad) || cantidad <= 0)
        {
            mensajes.Add(new MensajeChat
            {
                EsUsuario = false,
                Texto = "Por favor, ingresa una cantidad numérica mayor que cero."
            });

            SolicitarDesplazamiento();
            await InvokeAsync(StateHasChanged);
            return;
        }

        try
        {
            if (!Auth.IdHogarActivo.HasValue || productoPendiente == null)
                throw new InvalidOperationException("No hay un producto o un hogar seleccionado.");

            await InventarioSvc.IncorporarProductoAsync(
                Auth.IdHogarActivo.Value,
                productoPendiente.IdProducto,
                cantidad,
                0);

            mensajes.Add(new MensajeChat
            {
                EsUsuario = false,
                Tipo = "texto",
                Texto = $"¡Listo! Registré {cantidad:0.##} {productoPendiente.UnidadMedida} de {productoPendiente.Nombre} en el inventario de tu hogar."
            });

            productoPendiente = null;
            nombreProductoPendiente = "";
            estadoConversacion = EstadoConversacion.Normal;
        }
        catch (Exception ex)
        {
            mensajes.Add(new MensajeChat
            {
                EsUsuario = false,
                Tipo = "aviso",
                Texto = "No pude registrar el producto: " + ex.Message
            });
        }

        SolicitarDesplazamiento();
        await InvokeAsync(StateHasChanged);
    }



}
