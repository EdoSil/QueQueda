
@page "/login"
@using System.Net.Http.Json
@using System.Text.Json
@using QueQueda.Client.Services

@inject AuthService Auth
@inject HogarService Hogares
@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>Iniciar sesión | ¿Qué Queda?</PageTitle>

<main class="form-page">
    <section class="form-card">

        <div class="form-brand">
            <div class="form-logo">
                <img src="/icon-192.png"
                    alt="¿Qué Queda?"
                    style="width:100%; height:100%; object-fit:contain;" />
            </div>
            <h1>¿Qué Queda?</h1>
            <p>Tu hogar, al día.</p>
        </div>

        <div class="form-heading">
            <h2>Bienvenido de nuevo</h2>
            <p>Ingresa para consultar y organizar tu hogar.</p>
        </div>

        <form @onsubmit="IniciarSesionAsync"
              @onsubmit:preventDefault="true">

            <div class="form-field">
                <label for="correo">Correo electrónico</label>
                <input id="correo"
                       type="email"
                       @bind="correo"
                       autocomplete="username"
                       placeholder="nombre@correo.cl"
                       required />
            </div>

            <div class="form-field">
                <label for="contrasena">Contraseña</label>
                <input id="contrasena"
                       type="password"
                       @bind="contrasena"
                       autocomplete="current-password"
                       placeholder="Ingresa tu contraseña"
                       required />
            </div>

            @if (!string.IsNullOrWhiteSpace(mensaje))
            {
                <div class="alert alert-error" role="alert">
                    @mensaje
                </div>
            }

            <button class="form-submit"
                    type="submit"
                    disabled="@procesando">
                @(procesando ? "Ingresando..." : "Iniciar sesión")
            </button>
        </form>

        <p class="form-footer">
            ¿Todavía no tienes una cuenta?
            <a href="/registro">Crear cuenta</a>
        </p>

    </section>
</main>

@code {
    private string correo = string.Empty;
    private string contrasena = string.Empty;
    private string mensaje = string.Empty;
    private bool procesando;
    private string? returnUrl;

    private async Task IniciarSesionAsync()
    {
        if (procesando)
        {
            return;
        }

        procesando = true;
        mensaje = string.Empty;

        try
        {
            var datos = new
            {
                correo = correo.Trim(),
                contrasena = contrasena
            };

            using var respuesta = await Http.PostAsJsonAsync(
                "api/usuarios/login",
                datos
            );

            var contenido = await respuesta.Content.ReadAsStringAsync();

            Console.WriteLine(
                $"[LOGIN] Estado HTTP: {(int)respuesta.StatusCode}"
            );

            if (!respuesta.IsSuccessStatusCode)
            {
                mensaje = ObtenerMensajeError(contenido)
                    ?? "No se pudo iniciar sesión. Revisa tus credenciales.";

                Console.WriteLine("[LOGIN] Inicio de sesión rechazado.");
                return;
            }

            using var documento = JsonDocument.Parse(contenido);
            var raiz = documento.RootElement;

            if (!raiz.TryGetProperty("token", out var tokenJson)
                || tokenJson.ValueKind != JsonValueKind.String)
            {
                mensaje = "La respuesta del servidor no contiene un token válido.";
                Console.WriteLine("[LOGIN] No se encontró el token.");
                return;
            }

            var token = tokenJson.GetString();

            if (string.IsNullOrWhiteSpace(token))
            {
                mensaje = "El servidor devolvió un token vacío.";
                return;
            }

            var nombre = ObtenerNombre(raiz);

            Console.WriteLine(
                $"[LOGIN] Nombre recibido: {!string.IsNullOrWhiteSpace(nombre)}"
            );

            // Establecer y validar la sesión.
            await Auth.EstablecerSesionAsync(token, nombre);

            if (!Auth.SesionActiva)
            {
                mensaje = "Las credenciales fueron recibidas, pero no se pudo validar la sesión.";
                Console.WriteLine("[LOGIN] La sesión no quedó activa.");
                return;
            }

            Console.WriteLine("[LOGIN] Sesión iniciada correctamente.");

            // Si viene desde una invitación, regresar primero a ella.
            // La página de invitación procesará la aceptación.
            if (!string.IsNullOrWhiteSpace(returnUrl) &&
                returnUrl.StartsWith(
                    "/invitacion/",
                    StringComparison.OrdinalIgnoreCase))
            {
                Console.WriteLine("[LOGIN] Retornando a invitación pendiente.");

                Navigation.NavigateTo(returnUrl, forceLoad: false);
                return;
            }

            // Consultar los hogares asociados al usuario.
            var hogares = await Hogares.ObtenerHogaresAsync();

            Console.WriteLine(
                $"[LOGIN] Hogares asociados encontrados: {hogares.Count}"
            );

            // El usuario debe pertenecer al menos a un hogar.
            if (hogares.Count == 0)
            {
                Console.WriteLine("[LOGIN] Usuario sin hogar. Redirigiendo a Home para crear uno.");

                Navigation.NavigateTo("/");
                return;
            }

            // Si pertenece a un solo hogar, establecerlo como activo
            // y mostrar la pantalla de selección.
            if (hogares.Count == 1)
            {
                var hogar = hogares[0];

                await Auth.EstablecerHogarActivoAsync(
                    hogar.IdHogar,
                    hogar.Nombre
                );

                Console.WriteLine(
                    $"[LOGIN] Hogar activo: {hogar.Nombre}"
                );

                var destinoUnHogar = "/seleccionar-hogar";

                if (!string.IsNullOrWhiteSpace(returnUrl))
                {
                    destinoUnHogar += "?returnUrl=" +
                        Uri.EscapeDataString(returnUrl);
                }

                Navigation.NavigateTo(
                    destinoUnHogar,
                    forceLoad: false
                );

                return;
            }

            // Si pertenece a varios hogares, mostrar la selección.
            var destinoVariosHogares = "/seleccionar-hogar";

            if (!string.IsNullOrWhiteSpace(returnUrl))
            {
                destinoVariosHogares += "?returnUrl=" +
                    Uri.EscapeDataString(returnUrl);
            }

            Navigation.NavigateTo(
                destinoVariosHogares,
                forceLoad: false
            );
        }
        catch (HttpRequestException ex)
        {
            Console.WriteLine($"[LOGIN] Error de conexión: {ex.Message}");
            mensaje = "No fue posible conectar con el servidor. Inténtalo nuevamente.";
        }
        catch (JsonException ex)
        {
            Console.WriteLine($"[LOGIN] Error al interpretar JSON: {ex.Message}");
            mensaje = "La respuesta del servidor no tiene el formato esperado.";
        }
        catch (Microsoft.JSInterop.JSException ex)
        {
            Console.WriteLine($"[LOGIN] Error del navegador: {ex.Message}");
            mensaje = "No fue posible guardar la sesión en el navegador.";
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[LOGIN] Error inesperado: {ex.Message}");
            mensaje = "Ocurrió un error inesperado al iniciar sesión.";
        }
        finally
        {
            procesando = false;
        }
    }

    private static string ObtenerNombre(JsonElement raiz)
    {
        if (raiz.TryGetProperty("usuario", out var usuario)
            && usuario.ValueKind == JsonValueKind.Object)
        {
            var nombre = LeerPropiedadNombre(usuario);

            if (!string.IsNullOrWhiteSpace(nombre))
            {
                return nombre;
            }
        }

        return LeerPropiedadNombre(raiz);
    }

    private static string LeerPropiedadNombre(JsonElement elemento)
    {
        string[] propiedades =
        {
            "nombre",
            "nombre_usuario",
            "nombres",
            "nombre_completo"
        };

        foreach (var propiedad in propiedades)
        {
            if (elemento.TryGetProperty(propiedad, out var valor)
                && valor.ValueKind == JsonValueKind.String)
            {
                var texto = valor.GetString();

                if (!string.IsNullOrWhiteSpace(texto))
                {
                    return texto.Trim();
                }
            }
        }

        return string.Empty;
    }

    private static string? ObtenerMensajeError(string contenido)
    {
        try
        {
            using var documento = JsonDocument.Parse(contenido);
            var raiz = documento.RootElement;

            string[] propiedades =
            {
                "mensaje",
                "message",
                "error"
            };

            foreach (var propiedad in propiedades)
            {
                if (raiz.TryGetProperty(propiedad, out var valor)
                    && valor.ValueKind == JsonValueKind.String)
                {
                    var texto = valor.GetString();

                    if (!string.IsNullOrWhiteSpace(texto))
                    {
                        return texto;
                    }
                }
            }
        }
        catch (JsonException)
        {
            // La respuesta de error no contiene JSON válido.
        }

        return null;
    }

    protected override void OnInitialized()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);

        foreach (var parametro in uri.Query.TrimStart('?').Split('&'))
        {
            var partes = parametro.Split('=', 2);

            if (partes.Length != 2 ||
                Uri.UnescapeDataString(partes[0]) != "returnUrl")
            {
                continue;
            }

            var candidato = Uri.UnescapeDataString(
                partes[1].Replace("+", " ")
            );

            if (Uri.TryCreate(candidato, UriKind.Relative, out _) &&
                candidato.StartsWith("/") &&
                !candidato.StartsWith("//") &&
                !candidato.Contains('\\'))
            {
                returnUrl = candidato;
            }

            break;
        }
    }
}
