
@page "/productos"
@using QueQueda.Client.Services
@using Microsoft.AspNetCore.Components.Forms
@inject ProductoService ProductoService

<PageTitle>Productos | ¿Qué Queda?</PageTitle>

<div class="qq-dashboard">

    <div class="qq-page-heading">
        <div>
            <span class="qq-eyebrow">CATÁLOGO GENERAL</span>
            <h1>Productos</h1>
            <p>Productos compartidos para organizar los inventarios de los hogares.</p>
        </div>
    </div>

    <section class="qq-panel">

        <div class="qq-panel-heading">
            <div>
                <span class="qq-eyebrow">ADMINISTRACIÓN</span>
                <h2>Catálogo de productos</h2>
            </div>
        </div>

        <div style="display:flex; flex-wrap:wrap; gap:12px; justify-content:space-between; align-items:center; margin:20px 0;">

            <input type="search"
                   placeholder="Buscar productos..."
                   @bind="Busqueda"
                    @bind:event="oninput"
                    @bind:after="LimpiarMensajes"
                   style="max-width:400px; width:100%; padding:11px 14px; border:1px solid #e4e9e3; border-radius:8px;" />

            <button class="qq-button qq-button-primary"
                    @onclick="AbrirFormulario">
                + Agregar producto
            </button>

        </div>

        @if (Cargando)
        {
            <div class="qq-empty-state">
                <p>Cargando productos...</p>
            </div>
        }

        else if (!string.IsNullOrEmpty(Error))
        {
            <div class="alert alert-eliminacion">
                <div class="alert-eliminacion-titulo">
                    <span class="alert-eliminacion-icono">⚠</span>
                    <strong>No se puede eliminar este producto</strong>
                </div>

                <p class="alert-eliminacion-descripcion">
                    El producto tiene registros asociados en los siguientes hogares:
                </p>

                <ul class="alert-eliminacion-lista">
                    @{
                        var lineasError = Error.Split(
                            Environment.NewLine,
                            StringSplitOptions.RemoveEmptyEntries
                        );

                        foreach (var linea in lineasError.Skip(1))
                        {
                            <li>@linea</li>
                        }
                    }
                </ul>

                @if (SegundosAviso > 0)
                {
                    <div class="alert-eliminacion-tiempo">
                        Este mensaje desaparecerá en @SegundosAviso s.
                    </div>
                }
            </div>
}

        else if (!ProductosFiltrados.Any() && !MostrarFormulario)
        {
            <div class="qq-empty-state">
                <div class="qq-empty-icon">▤</div>

                @if (ListaProductos.Count == 0)
                {
                    <h3>Tu catálogo comenzará aquí</h3>
                    <p>Todavía no hay productos registrados.</p>
                }
                else
                {
                    <h3>No se encontraron productos</h3>
                    <p>Intenta con otro nombre o categoría.</p>
                }
            </div>
        }
        else if (ProductosFiltrados.Any())
        {
            <div style="overflow-x:auto;">
                <table style="width:100%; border-collapse:collapse; text-align:left;">

                    <thead>
                        <tr style="border-bottom:1px solid #e4e9e3;">
                            <th style="padding:12px 10px;">Producto</th>
                            <th style="padding:12px 10px;">Categoría</th>
                            <th style="padding:12px 10px;">Cantidad de referencia</th>
                            <th style="padding:12px 10px;">Unidad</th>
                            <th style="padding:12px 10px;">Acciones</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var producto in ProductosFiltrados)
                        {
                            <tr style="border-bottom:1px solid #e4e9e3;">

                                <td style="padding:12px 10px;">
                                    <strong>@producto.Nombre</strong>
                                </td>

                                <td style="padding:12px 10px;">
                                    @(string.IsNullOrWhiteSpace(producto.Categoria)
                                        ? "Sin categoría"
                                        : producto.Categoria)
                                </td>

                                <td style="padding:12px 10px;">
                                    @producto.Cantidad
                                </td>

                                <td style="padding:12px 10px;">
                                    @producto.UnidadMedida
                                </td>

                                <td style="padding:12px 10px;">

                                    @if (_idProductoPendienteEliminar == producto.IdProducto)
                                    {
                                        <div class="qq-crud-confirm">
                                            <span>¿Eliminar este producto?</span>

                                            <div class="qq-crud-confirm-actions">
                                                <button type="button"
                                                        class="qq-button qq-button-danger"
                                                        @onclick="() => EliminarProductoAsync(producto.IdProducto)"
                                                        disabled="@Eliminando">
                                                    Sí, eliminar
                                                </button>

                                                <button type="button"
                                                        class="qq-button"
                                                        @onclick="CancelarEliminarProducto"
                                                        disabled="@Eliminando">
                                                    Cancelar
                                                </button>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="qq-crud-actions">

                                            <button type="button"
                                                    class="qq-crud-action"
                                                    title="Editar producto"
                                                    aria-label="Editar producto"
                                                    @onclick="() => EditarProducto(producto)">

                                                <svg xmlns="http://www.w3.org/2000/svg"
                                                     width="17"
                                                     height="17"
                                                     viewBox="0 0 24 24"
                                                     fill="none"
                                                     stroke="currentColor"
                                                     stroke-width="2"
                                                     stroke-linecap="round"
                                                     stroke-linejoin="round">
                                                    <path d="M12 20h9" />
                                                    <path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L8 18l-4 1 1-4Z" />
                                                </svg>

                                            </button>

                                            <button type="button"
                                                    class="qq-crud-action qq-crud-action-delete"
                                                    title="Eliminar producto"
                                                    aria-label="Eliminar producto"
                                                    @onclick="() => SolicitarEliminarProducto(producto.IdProducto)">

                                                <svg xmlns="http://www.w3.org/2000/svg"
                                                     width="17"
                                                     height="17"
                                                     viewBox="0 0 24 24"
                                                     fill="none"
                                                     stroke="currentColor"
                                                     stroke-width="2"
                                                     stroke-linecap="round"
                                                     stroke-linejoin="round">
                                                    <path d="M3 6h18" />
                                                    <path d="M8 6V4h8v2" />
                                                    <path d="m19 6-1 14H6L5 6" />
                                                    <path d="M10 11v5" />
                                                    <path d="M14 11v5" />
                                                </svg>

                                            </button>

                                        </div>
                                    }

                                </td>

                            </tr>
                        }
                    </tbody>

                </table>
            </div>

            <p style="margin-top:16px; color:#758078; font-size:0.9rem;">
                Productos encontrados: @ProductosFiltrados.Count
            </p>
        }

        @if (MostrarFormulario)
        {
            <div class="qq-panel" style="margin-bottom:20px;">

                <h3>@(Editando ? "Editar producto" : "Registrar producto")</h3>

                <EditForm Model="NuevoProducto"
                          OnValidSubmit="GuardarProductoAsync">

                    <DataAnnotationsValidator />

                    <div class="form-field">
                        <label>Nombre del producto</label>
                        <InputText @bind-Value="NuevoProducto.Nombre"
                                   placeholder="Ej. Leche" />
                    </div>

                    <div class="form-field">
                        <label>Categoría</label>
                        <InputText @bind-Value="NuevoProducto.Categoria"
                                   placeholder="Ej. Lácteos" />
                    </div>

                    <div class="form-field">
                        <label>Cantidad de referencia</label>
                        <InputNumber @bind-Value="NuevoProducto.Cantidad"
                                     min="0.01" />
                    </div>

                    <div class="form-field">
                        <label>Unidad de medida</label>
                        <InputText @bind-Value="NuevoProducto.UnidadMedida"
                                   placeholder="Ej. unidad, kg, litro" />
                    </div>

                    <ValidationSummary />

                    @if (!string.IsNullOrWhiteSpace(MensajeFormulario))
                    {
                        <div class="alert">
                            @MensajeFormulario
                        </div>
                    }

                    <button type="submit"
                            class="qq-button qq-button-primary"
                            disabled="@Guardando">
                        @(Guardando
                            ? "Guardando..."
                            : Editando ? "Guardar cambios" : "Guardar producto")
                    </button>

                    <button type="button"
                            class="qq-button"
                            @onclick="CerrarFormulario">
                        Cancelar
                    </button>

                </EditForm>

            </div>
        }

        @if (!string.IsNullOrWhiteSpace(MensajeGeneral))
        {
            <div class="alert">@MensajeGeneral</div>
        }

    </section>

</div>

@code {
    private List<ProductoDto> ListaProductos = new();

    private string Busqueda = string.Empty;
    private bool Cargando = true;
    private string Error = string.Empty;

    private bool MostrarFormulario;
    private bool Guardando;
    private bool Editando;
    private bool Eliminando;

    private string MensajeFormulario = string.Empty;
    private string MensajeGeneral = string.Empty;
    private int? _idProductoPendienteEliminar;

    private int SegundosAviso;
    private CancellationTokenSource? _avisoCts;


    private ProductoDto NuevoProducto = new()
    {
        Cantidad = 1,
        UnidadMedida = "unidad"
    };

    private List<ProductoDto> ProductosFiltrados =>
        ListaProductos
            .Where(p =>
                (p.Nombre ?? "").Contains(
                    Busqueda,
                    StringComparison.OrdinalIgnoreCase
                ) ||
                (p.Categoria ?? "").Contains(
                    Busqueda,
                    StringComparison.OrdinalIgnoreCase
                )
            )
            .ToList();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            ListaProductos = await ProductoService.ObtenerProductosAsync();
        }
        catch (Exception ex)
        {
            Error = ex.Message;
        }
        finally
        {
            Cargando = false;
        }
    }

    private void AbrirFormulario()
    {
        Editando = false;
        MensajeFormulario = string.Empty;
        MensajeGeneral = string.Empty;

        NuevoProducto = new ProductoDto
        {
            Cantidad = 1,
            UnidadMedida = "unidad"
        };

        MostrarFormulario = true;
    }

    private void EditarProducto(ProductoDto producto)
    {
        Editando = true;
        MensajeFormulario = string.Empty;
        MensajeGeneral = string.Empty;

        NuevoProducto = new ProductoDto
        {
            IdProducto = producto.IdProducto,
            Nombre = producto.Nombre,
            Categoria = producto.Categoria,
            Cantidad = producto.Cantidad,
            UnidadMedida = producto.UnidadMedida
        };

        MostrarFormulario = true;
    }

    private void CerrarFormulario()
    {
        MostrarFormulario = false;
        Editando = false;
        MensajeFormulario = string.Empty;
    }

    private async Task GuardarProductoAsync()
    {
        if (Guardando)
            return;

        Guardando = true;
        Error = string.Empty;
        _idProductoPendienteEliminar = null;
        MensajeFormulario = string.Empty;
        MensajeGeneral = string.Empty;

        try
        {
            if (Editando)
            {
                await ProductoService.ActualizarProductoAsync(NuevoProducto);
                MensajeGeneral = "Producto actualizado correctamente.";
            }
            else
            {
                await ProductoService.CrearProductoAsync(NuevoProducto);
                MensajeGeneral = "Producto registrado correctamente.";
            }

            ListaProductos = await ProductoService.ObtenerProductosAsync();

            MostrarFormulario = false;
            Editando = false;

            NuevoProducto = new ProductoDto
            {
                Cantidad = 1,
                UnidadMedida = "unidad"
            };
        }
        catch (Exception ex)
        {
            MensajeFormulario = ex.Message;
        }
        finally
        {
            Guardando = false;
        }
    }

    private void SolicitarEliminarProducto(int idProducto)
    {
        _idProductoPendienteEliminar = idProducto;
    }

    private void CancelarEliminarProducto()
    {
        _idProductoPendienteEliminar = null;
    }

    private async Task EliminarProductoAsync(int idProducto)
    {
        if (Eliminando)
            return;

        Eliminando = true;
        Error = string.Empty;
        MensajeGeneral = string.Empty;

        try
        {
            await ProductoService.EliminarProductoAsync(idProducto);

            ListaProductos = await ProductoService.ObtenerProductosAsync();

            _idProductoPendienteEliminar = null;
            MensajeGeneral = "Producto eliminado correctamente.";
        }
        catch (Exception ex)
        {
            Error = ex.Message;
            await MostrarAvisoTemporalAsync();
        }
        finally
        {
            Eliminando = false;
        }
    }

    private void LimpiarMensajes()
    {
        SegundosAviso = 0;
        _avisoCts?.Cancel();
        Error = string.Empty;
        MensajeGeneral = string.Empty;
        MensajeFormulario = string.Empty;
        _idProductoPendienteEliminar = null;
    }


    private async Task MostrarAvisoTemporalAsync()
    {
        _avisoCts?.Cancel();
        _avisoCts?.Dispose();

        _avisoCts = new CancellationTokenSource();
        var token = _avisoCts.Token;

        try
        {
            for (int i = 5; i > 0; i--)
            {
                SegundosAviso = i;
                StateHasChanged();

                await Task.Delay(1000, token);
            }

            Error = string.Empty;
            SegundosAviso = 0;

            StateHasChanged();
        }
        catch (OperationCanceledException)
        {
            // El aviso fue limpiado por una nueva acción.
        }
    }

}
